# Copy to .env and set the address of your API, then restart `npx expo start`.
# EXPO_PUBLIC_ values are baked into the app, so never put a secret here.
#
# Deployed API (the Render address, with or without the /api/v1 ending):
#   EXPO_PUBLIC_API_URL=https://your-api.onrender.com
#
# Your own computer while developing: the phone cannot reach "localhost", so use
# the computer's address on the same Wi-Fi (run ipconfig / ifconfig to find it):
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:5000
#
# Android emulator only (the emulator's name for the host computer):
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
EXPO_PUBLIC_API_URL=
