{
  "expo": {
    "name": "CityCart Partner",
    "slug": "citycart-partner",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "citycart-partner",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f8f9fa",
    "ios": {
      "bundleIdentifier": "com.citycart.partner",
      "supportsTablet": false
    },
    "android": {
      "package": "com.citycart.partner",
      "adaptiveIcon": {
        "backgroundColor": "#1e3a2f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8f9fa",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CityCart Partner uses your location, only while you choose to share it and have a delivery out, so the customer and your brand can see where you are."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1e3a2f",
          "defaultChannel": "default"
        }
      ]
    ]
  }
}
