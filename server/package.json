{
  "name": "citycart-server",
  "version": "0.1.0",
  "private": true,
  "description": "CityCart backend (Node.js, Express, Mongoose) — modular monolith",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint .",
    "test": "jest"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "eslint": "^9.9.1",
    "globals": "^15.9.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.4",
    "supertest": "^7.3.0"
  }
}
