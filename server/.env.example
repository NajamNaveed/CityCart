# CityCart backend environment variables.
# Copy this file to .env and fill in real values. Never commit .env.

# --- Used today (Phase 0/1/Auth) ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_secure_jwt_secret
JWT_EXPIRES_IN=7d
# Staff dashboard sessions (brand admin/employees, platform admin) are
# short-lived, renewed on every staff request, and end when the tab closes
# (client-side gate). Shoppers keep the full JWT_EXPIRES_IN session.
STAFF_SESSION_HOURS=8

# --- Transactional email: verification + password reset (docs/06) ---
# Render's free plan blocks outbound SMTP, so CityCart posts to Brevo's HTTPS
# API instead. Create a Brevo account, verify a sender address, then copy the
# API key from Brevo > SMTP & API > API Keys. Without a key and sender the
# server logs the links in development and reports email as unavailable in
# production (sign-up still works; the user can ask for a new link).
BREVO_API_KEY=
# Must be an address (or domain) verified in Brevo, e.g. no-reply@citycart.pk
EMAIL_FROM=
EMAIL_FROM_NAME=CityCart
# How long the emailed links stay valid. Verification: hours (1-168, default 24).
# Reset: minutes (5-1440, default 60). Both links work only once.
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# --- Later phases: read from README/docs, not yet consumed by app code ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Hours a terminated brand's staff keep read-only access (0 = immediate)
TERMINATION_GRACE_HOURS=24

# --- Payment proof photos at the door (docs/21 §I.4) ---
# Needs CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET above.
# Without Cloudinary the Partner app offers cash only (proof endpoints answer 503).
# Minutes a signed proof photo link stays valid (1 to 60).
PAYMENT_PROOF_LINK_MINUTES=5
# Days after the brand verifies/rejects a proof before its photo is deleted (1 to 3650).
PAYMENT_PROOF_RETENTION_DAYS=90

# --- Push notifications to the Partner app (docs/12 §28) ---
# Off by default. Set to true only when the Partner app is built as a development/production build
# (Expo Go on Android cannot receive push notifications). Uses Expo's push service; no package needed.
PUSH_ENABLED=false
# Optional: an Expo access token if you turned on "enhanced push security" in your Expo account.
EXPO_ACCESS_TOKEN=
