{
  "expo": {
    "name": "CityCart",
    "slug": "citycart",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "citycart",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f8f9fa",
    "ios": {
      "bundleIdentifier": "com.citycart.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.citycart.app",
      "adaptiveIcon": {
        "backgroundColor": "#b6472a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fdf5ed",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CityCart uses your location to show the shops closest to you. It is only used while you are in the app."
        }
      ]
    ]
  }
}
