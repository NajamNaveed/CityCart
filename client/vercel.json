{
  "routes": [
    { "src": "/api/(.*)", "dest": "${RENDER_API_URL}/api/$1", "env": ["RENDER_API_URL"] },
    { "src": "/socket.io/(.*)", "dest": "${RENDER_API_URL}/socket.io/$1", "env": ["RENDER_API_URL"] },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "git": { "deploymentEnabled": false }
}
