VITE_API_URL=http://localhost:5000/api/v1
# In production (Vercel), leave VITE_API_URL EMPTY: /api/v1 requests then go to the
# Vercel domain itself, which proxies them to Render (see client/vercel.json). This
# keeps the auth cookie first-party — required for logins to survive browsers that
# block third-party cookies.
#
# The Render host for /api/* and /socket.io/* is written in client/vercel.json
# (Vercel rewrites cannot read environment variables). If the Render URL changes,
# edit that file and redeploy the client.
